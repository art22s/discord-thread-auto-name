{
  "id": "discord-thread-auto-name",
  "name": "AI Discord Thread Titles",
  "description": "Create concise AI titles for Discord threads from their OpenClaw conversation history.",
  "categories": ["channels"],
  "activation": {
    "onCapabilities": ["hook"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "autoName": {
        "oneOf": [{ "type": "boolean" }, { "type": "integer", "minimum": 0 }]
      },
      "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
      "model": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^\\S+(?![\\s\\S])",
        "description": "Model reference (provider/model) or configured alias for isolated title generation and history summaries. Defaults to the agent's configured model."
      },
      "accounts": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autoName": {
              "oneOf": [{ "type": "boolean" }, { "type": "integer", "minimum": 0 }]
            },
            "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^\\S+(?![\\s\\S])",
              "description": "Override the naming model for this Discord account."
            }
          }
        }
      }
    }
  }
}
